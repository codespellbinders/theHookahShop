# Gmail SMTP (do NOT commit real secrets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="Your Name <your-email@gmail.com>"

# Optional helper flags
# SMTP_SERVICE=gmail
# SMTP_POOL=false
# SMTP_REQUIRE_TLS=true
# SMTP_TIMEOUT_MS=7000

# Secret used to HMAC verification codes before storing in DB. Use a long random string in production.
CODE_HASH_SECRET=replace_with_a_long_random_secret

# Database (example)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=hookahshop

# Optional: other envs
# NODE_ENV=production

# Admin auth settings
ADMIN_JWT_SECRET=replace_with_a_long_random_secret
ADMIN_JWT_EXPIRES_IN=12h
# If set, required in x-setup-key header when bootstrapping first super admin
# ADMIN_SETUP_KEY=replace_with_setup_key
